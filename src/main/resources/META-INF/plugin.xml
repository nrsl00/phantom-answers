<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.phantomanswers.phantom-answers</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Phantom Answers</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor>Phantom Answers</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Phantom Answers is an educational IntelliJ IDEA plugin
        that demonstrates controlled input-to-output simulation
        inside the IDE.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MyToolWindow" factoryClass="com.phantomanswers.MyToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
                id="Phantom Answers"
                displayType="BALLOON"
                isLogByDefault="false"/>
    </extensions>

    <actions>

        <action
                id="com.phantomanswers.ToggleSimulation"
                class="com.phantomanswers.ToggleSimulationAction"
                text="Toggle Phantom Simulation"
                description="Switch between Normal and Simulation mode">

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control shift Q"/>

        </action>

        <action
                id="com.phantomanswers.SelectLab1"
                class="com.phantomanswers.SelectLab1Action"
                text="Phantom Lab 1">

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 1"/>

        </action>

        <action
                id="com.phantomanswers.SelectLab2"
                class="com.phantomanswers.SelectLab2Action"
                text="Phantom Lab 2">

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 2"/>

        </action>

        <action
                id="com.phantomanswers.SelectLab3"
                class="com.phantomanswers.SelectLab3Action"
                text="Phantom Lab 3">

            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 3"/>

        </action>

        <action
                id="com.phantomanswers.SelectLab4"
                class="com.phantomanswers.SelectLab4Action"
                text="Phantom Lab 4">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 4"/>
        </action>

        <action
                id="com.phantomanswers.SelectLab5"
                class="com.phantomanswers.SelectLab5Action"
                text="Phantom Lab 5">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 5"/>
        </action>

        <action
                id="com.phantomanswers.SelectLab6"
                class="com.phantomanswers.SelectLab6Action"
                text="Phantom Lab 6">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 6"/>
        </action>

        <action
                id="com.phantomanswers.SelectLab7"
                class="com.phantomanswers.SelectLab7Action"
                text="Phantom Lab 7">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 7"/>
        </action>

        <action
                id="com.phantomanswers.SelectLab8"
                class="com.phantomanswers.SelectLab8Action"
                text="Phantom Lab 8">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 8"/>
        </action>

        <action
                id="com.phantomanswers.SelectLab9"
                class="com.phantomanswers.SelectLab9Action"
                text="Phantom Lab 9">
            <keyboard-shortcut
                    keymap="$default"
                    first-keystroke="control alt 9"/>
        </action>

    </actions>

</idea-plugin>